-- Criar categorias
local function category(name)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -5, 0, 30)
    label.BackgroundTransparency = 1
    label.Text = "┃ " .. name
    label.TextColor3 = Color3.fromRGB(40, 190, 255)
    label.TextSize = 14
    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = content
end

-- Criar botões ON/OFF apenas visuais
local function toggle(name)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -5, 0, 35)
    row.BackgroundTransparency = 1
    row.Parent = content

    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, -75, 1, 0)
    text.BackgroundTransparency = 1
    text.Text = name
    text.TextColor3 = Color3.fromRGB(225, 235, 245)
    text.TextSize = 12
    text.Font = Enum.Font.Gotham
    text.TextXAlignment = Enum.TextXAlignment.Left
    text.Parent = row

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0, 48, 0, 23)
    button.Position = UDim2.new(1, -52, 0.5, -11)
    button.Text = "OFF"
    button.TextSize = 10
    button.Font = Enum.Font.GothamBold
    button.TextColor3 = Color3.new(1, 1, 1)
    button.BackgroundColor3 = Color3.fromRGB(65, 75, 90)
    button.Parent = row

    local enabled = false

    button.MouseButton1Click:Connect(function()
        enabled = not enabled
        button.Text = enabled and "ON" or "OFF"
        button.BackgroundColor3 = enabled
            and Color3.fromRGB(0, 165, 245)
            or Color3.fromRGB(65, 75, 90)
    end)
end

